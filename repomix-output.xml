const TRANSMUTATION_TABLE = [
  { min: 0, grade: 60 },
  { min: 4.68, grade: 61 },
  { min: 9.35, grade: 62 },
  { min: 14.01, grade: 63 },
  { min: 18.68, grade: 64 },
