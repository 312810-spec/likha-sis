  query: vi.fn((...args) => ({ kind: "query", args })),
  where: vi.fn((...args) => ({ kind: "where", args })),
  // WeatherCard reads the school's coordinates via useSchoolConfig, which
  // subscribes with doc/onSnapshot. No coordinates means the card just
  // renders its "needs coordinates" state rather than fetching weather.
  doc: vi.fn(() => ({ kind: "doc" })),
