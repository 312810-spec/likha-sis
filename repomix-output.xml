}

# Regex pattern for OpenAI keys (sk-...), GitHub PATs (ghp_...), Anthropic (sk-ant-...), AWS, and generic API keys
$secretPattern = '(sk-[a-zA-Z0-9]{32,}|ghp_[a-zA-Z0-9]{36}|sk-ant-[a-zA-Z0-9]{32,}|AKIA[0-9A-Z]{16})'

