            <div style={{ textAlign: "center", color: "#000" }}>
              <div style={{ fontWeight: "bold", fontSize: "13pt", lineHeight: 1.3 }}>
                School Form 8 (SF8) Learner&apos;s Basic Health and Nutrition Report
              </div>
