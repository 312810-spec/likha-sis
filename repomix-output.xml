                  </div>
                )}

                <div>
                  <label htmlFor="assignGradeInput" className="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Grade Level</label>
                  <input
                    id="assignGradeInput"
                    type="text"
                    value={assignGrade}
                    onChange={(e) => setAssignGrade(e.target.value)}
