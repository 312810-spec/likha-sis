          </div>
          <div>
            <label className="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">
              Section
            </label>
            <select
              value={section}
              onChange={(e) => {
                const selected = e.target.value;
                if (selected === "+") {
                  setShowNewSection(true);
                  setNewSection("");
                } else {
