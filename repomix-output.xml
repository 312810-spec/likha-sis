import { describe, it, expect } from "vitest";
import { computeSMEAEnrollment, parseGradeNumber } from "../utils/smeaEnrollment.js";

describe("smeaEnrollment utils", () => {
  const mockCalendar = {
    "2026-2027": {
      schoolYearLabel: "2026-2027",
