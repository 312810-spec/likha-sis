// src/utils/bmiForAgeTable.js
//
// Official DepEd / WHO BMI-for-Age reference table (WHO 2007 growth reference,
// 5 to 19 years), sourced from the DepEd School Form 8 (SF8) workbook's
// "BMI Tables" sheet. Do not hand-edit these numbers; if a correction is
// ever needed, re-export from the source SF8 file.
//
// Each row: [ageInMonths, boysSeverelyWastedMax, boysWastedMax, boysNormalMax,
//   boysOverweightMax, girlsSeverelyWastedMax, girlsWastedMax, girlsNormalMax,
//   girlsOverweightMax]
//
// Classification logic (matches the SF8 workbook formulas):
//   BMI <= severelyWastedMax        -> Severely Wasted
//   BMI <= wastedMax                -> Wasted
//   BMI <= normalMax                -> Normal
//   BMI <= overweightMax            -> Overweight
//   BMI >  overweightMax            -> Obese
//
// Table covers ages 60 to 228 months (5 to 19 years). Outside that range,
// classification is not defined by this table.

export const BMI_FOR_AGE_TABLE = [
  [60, 12.0, 12.9, 18.3, 20.2, 11.7, 12.6, 18.9, 21.2],
  [61, 12.0, 12.9, 18.3, 20.2, 11.7, 12.6, 18.9, 21.3],
