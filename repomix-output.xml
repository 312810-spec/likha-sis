      ) : (
        <div className="id-print-area" style={{ display: "flex", flexWrap: "wrap", gap: "14px" }}>
          {sectionFilter && sectionLearners.length === 0 && (
            <p className="no-print text-sm text-gray-400 dark:text-gray-500">
