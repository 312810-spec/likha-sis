rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true if someone is logged in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: reads the caller's own user doc and returns their roles array.
    // Returns an empty list if the doc doesn't exist yet (e.g. brand new
    // account created but Firestore doc not written), so checks fail closed.
    function myRoles() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        : [];
    }

    // Helper: true if the caller has at least one of the given roles.
    function hasAnyRole(roles) {
      return myRoles().hasAny(roles);
    }

    // Helper: true once first-run setup has actually finished. Firestore
    // rules can't check "is this collection empty", so we use a sentinel
    // field on a single known document instead. Before setup finishes,
    // this document either doesn't exist yet or lacks setupCompletedAt.
    function isSetupComplete() {
      return exists(/databases/$(database)/documents/settings/schoolConfig) &&
        ('setupCompletedAt' in get(/databases/$(database)/documents/settings/schoolConfig).data);
    }

    // ---- learners ----
    // Read: every real staff role except stakeholder (matches ViewLearners
    // access). Deliberately an ALLOWLIST of ROLE_OPTIONS, not a blocklist on
    // "stakeholder" alone -- a blocklist would also pass a signed-in account
    // with NO users/{uid} doc at all (myRoles() == []), leaking every
    // learner's PII to anyone who can create a bare Firebase Auth account.
    // Create: adviser, ictCoordinator, principal (matches SF1 access).
    // Update/delete: adviser only (matches ViewLearners edit permission).
    match /learners/{learnerId} {
      allow read: if hasAnyRole(["principal", "masterTeacher", "adviser", "subjectTeacher", "ictCoordinator", "smeaCoordinator", "guidance"]);
      allow create: if hasAnyRole(["adviser", "ictCoordinator", "principal"]);
      allow update, delete: if hasAnyRole(["adviser"]);
    }

    // ---- attendance (SF2) ----
    // Write stays adviser-only. Read is also open to the other LARDO
    // Tracking viewer roles, since the 14-day auto-resolve check re-reads
    // current attendance rates to decide whether a flag can clear.
    match /attendance/{document} {
      allow read: if hasAnyRole(["adviser", "masterTeacher", "principal", "smeaCoordinator", "guidance"]);
      allow write: if hasAnyRole(["adviser"]);
    }

    // ---- sf4Mortality (SF4 dropout/mortality summary inputs) ----
    // Matches the sf4 entry in pageAccess.js — adviser-only, both for
    // reading back a previously saved summary and for writing new figures.
    match /sf4Mortality/{document} {
      allow read, write: if hasAnyRole(["adviser"]);
    }

    // ---- classRecords ----
    // Write stays subjectTeacher/adviser-only. Read is also open to the
    // other LARDO Tracking viewer roles for the same auto-resolve reason.
    match /classRecords/{recordId} {
      allow read: if hasAnyRole(["subjectTeacher", "adviser", "masterTeacher", "principal", "smeaCoordinator", "guidance"]);
      allow write: if hasAnyRole(["subjectTeacher", "adviser"]);
    }

    // ---- lardoRecords ----
    // Mirrors the lardoTracking entry in pageAccess.js — anyone who can open
    // the LARDO Tracking page must also be able to read/write its records.
    // subjectTeacher is included too: it can't open the LARDO Tracking page,
    // but it can confirm an auto-flag banner from Class Record / Consolidated
    // Grades, which needs write access to the specific record confirmed.
    match /lardoRecords/{recordId} {
      allow read, write: if hasAnyRole(["adviser", "masterTeacher", "principal", "smeaCoordinator", "guidance", "subjectTeacher"]);
    }

    // ---- nutritionRecords ----
    match /nutritionRecords/{recordId} {
      allow read, write: if hasAnyRole(["adviser", "smeaCoordinator"]);
    }

    // ---- academicRecords (SF10 imports + SF10 Generator) ----
    // One imported document per learner per school year + grade level.
    // Write stays ictCoordinator-only (matches sf10Import in pageAccess.js --
    // only the importer writes this collection). Read now also includes
    // adviser/principal so they can see imported history when generating
    // SF10 (matches sf10Generate in pageAccess.js).
    match /academicRecords/{recordId} {
      allow read: if hasAnyRole(["ictCoordinator", "adviser", "principal"]);
      allow write: if hasAnyRole(["ictCoordinator"]);
    }

    // ---- disciplinaryRecords (DO 006 Safe Environment / LRP) ----
    // 3-tier behavioral incident classification, shown as a role-gated tab
    // inside LARDO Tracking. Deliberately narrower than lardoRecords above —
    // mirrors DISCIPLINE_STAFF_ROLES in pageAccess.js.
    match /disciplinaryRecords/{recordId} {
      allow read, write: if hasAnyRole(["smeaCoordinator", "principal", "guidance"]);
    }

    // ---- transfers ----
    match /transfers/{transferId} {
      allow read, write: if hasAnyRole(["adviser", "ictCoordinator", "principal", "smeaCoordinator"]);
    }

    // ---- importBatches (SF1/SF10 bulk import + Import Center) ----
    match /importBatches/{batchId} {
      allow read, write: if hasAnyRole(["ictCoordinator"]);
    }

    // ---- users (User Management) ----
    // Anyone signed in can read their own doc (needed for useUserProfile to
    // work for every role). ictCoordinator/principal can manage any account.
    // Special case: during first-run setup, before setup is complete, a
    // brand-new account may create ONLY its own doc, and only with the
    // ictCoordinator role, so a fresh school can bootstrap its first admin
    // account through SetupWizard without a chicken-and-egg problem.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if hasAnyRole(["ictCoordinator", "principal"]);
      allow create: if !isSetupComplete()
        && isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.roles.hasOnly(["ictCoordinator"]);
      // Self-service Account Settings (AccountSettings.jsx): any signed-in
      // user may update their OWN fullName, and only that field -- roles/
      // assignments must stay ictCoordinator/principal-only above, so a user
      // editing their own doc can't grant themselves a different role.
      //
      // Exception: an ICT Coordinator may also self-edit their own `roles`
      // (e.g. adding a second role to themselves), but only while both the
      // stored value AND the new value still contain "ictCoordinator" --
      // this is the server-side half of the self-lockout guard (the UI
      // additionally disables unchecking that role on your own account).
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fullName"])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fullName", "roles"])
            && resource.data.roles.hasAny(["ictCoordinator"])
            && request.resource.data.roles.hasAny(["ictCoordinator"])
          )
        );
    }

    // ---- settings (school config, branding, setup state) ----
    // Read: any signed-in user BEFORE setup completes (needed for
    // SetupWizard/App.jsx to check setup state during first-run bootstrap,
    // when a brand-new account has no users/{uid} doc -- and therefore no
    // role -- yet). Once setup is complete, requires a real ROLE_OPTIONS
    // role like every other collection, so a signed-in account with no
    // assigned role can't read school config after launch.
    // Write: ictCoordinator/principal normally, OR anyone during first-run
    // setup (before isSetupComplete), so a brand-new school can write its
    // own settings/schoolConfig doc while bootstrapping.
    match /settings/{document} {
      allow read: if !isSetupComplete()
        || hasAnyRole(["principal", "masterTeacher", "adviser", "subjectTeacher", "stakeholder", "ictCoordinator", "smeaCoordinator", "guidance"]);
      allow write: if hasAnyRole(["ictCoordinator", "principal"]) || !isSetupComplete();
    }

    // Catch-all: anything NOT explicitly listed above is blocked completely,
    // even for logged-in users. This is a safety net so we never accidentally
    // leave a new collection wide open later without thinking about it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
