# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Firebase CLI agent skills (auto-installed by `firebase init`, not project source)
.agents/
.claude/skills/*
skills-lock.json

# Project-authored skills ARE project source — track them.
!.claude/skills/do15-grading-audit/
!.claude/skills/lardo-safety-audit/
!.claude/skills/print-safety-audit/
!.claude/skills/firestore-schema-sync/

# graphify knowledge-graph output (generated, not project source)
graphify-out/

# Ad-hoc local debug/inspection scripts and their output. These are
# throwaway by convention (see CLAUDE.md workflow notes) and have already
# leaked real learner PII into git once via a committed workbook-cell dump
# (tmp-sf1-dump.txt) -- never track anything under this prefix.
tmp-*

# Real DepEd sample workbooks/exports used to validate the SF1/SF8/SF10
# importers locally. They hold real learner personal information (full names,
# LRNs, birth dates, parents' names and addresses of minors) and everything
# under public/ is copied verbatim into the build output and served publicly,
# so they must never be committed. Importer tests use invented learners and
# skip when a sample is absent.
public/SF1_*.xls
public/SF1_*.xlsx
public/*_SF10.xlsx
public/*_SF10.xls
# School administrative documents and workbooks (may contain staff/learner PII)
public/*.xlsx
public/*.xls
public/*.docx
public/*.doc
# Large uploaded school images (not app assets — handled via Firestore Storage)
public/Tingub*
public/*National*
public/*loading-minutes*
public/School Form*

# Environment variable files — never commit actual secrets.
# Only .env.example (with placeholder values) should be tracked.
.env
.env.local
.env.*.local
.env.production
.env.development

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.aider*
.worktrees/
.superpowers/
