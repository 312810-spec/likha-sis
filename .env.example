# .env.example — copy to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
#
# ─── Firebase Web App Config ────────────────────────────────────────────────
# These values are safe to make public (they identify the project, not grant
# admin access). Security is enforced by Firestore Security Rules + Auth.
# Get them from: Firebase Console → Project Settings → General → Your Apps.
#
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── IMPORTANT: NEVER commit these ─────────────────────────────────────────
# Firebase Admin SDK service account keys (server-side / Cloud Functions only)
# FIREBASE_ADMIN_SDK_KEY=...         ← store in CI/CD secrets or .env.local only
#
# Any API keys for third-party services should also be stored in .env.local.
